# Copy to .env and fill in. Never commit real secrets.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://ciba:ciba@localhost:5432/ciba?schema=public"

# --- Auth.js / NextAuth v5 ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
